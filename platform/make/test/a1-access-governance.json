          [
            { "a": "D", "b": "pending", "o": "text:equal" },
            { "a": "E", "b": "{{now}}", "o": "date:lessorequal" }
          ]
        ],
        "sortOrder": "asc",
        "orderBy": "E",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "limit": 25
      },
      "metadata": {
        "designer": { "x": 0, "y": 0, "label": "Due Work_Queue tasks only (max 25)" }
      }
    },
    {
      "id": 2,
      "module": "datastore:ExistRecord",
      "version": 1,
      "parameters": { "datastore": 151407 },
      "filter": {
        "name": "At least one due queue row returned",
        "conditions": [[{ "a": "{{1.__IMTLENGTH__}}", "b": "0", "o": "number:greater" }]]
