{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcanium-platform-core-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "test",
    "TEST_CLIENT_IDS": "TEST-0001,TEST-0002",
    "MAX_EVENT_BYTES": "65536",
    "REPLAY_WINDOW_SECONDS": "300",
    "ALLOW_SCENARIO_ACTIVATION": "false",
    "ALLOW_PRODUCTION_DEPLOY": "false",
    "ALLOW_PUBLIC_SEND": "false",
    "ALLOW_CONTENT_PUBLISH": "false",
    "ALLOW_GBP_MUTATION": "false",
    "ALLOW_OUTREACH_SEND": "false",
    "ALLOW_DANGEROUS_REPLAY": "false",
    "ALLOW_SITE_LAUNCH": "false",
    "ALLOW_EXPERIMENT_LAUNCH": "false",
    "ALLOW_PRICING_CHANGE": "false",
    "ALLOW_MAKE_A12_DISPATCH": "false"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_OPS_DB",
      "database_name": "test-platform-ops-state",
      "database_id": "3d76527c-ae04-4c65-a8e1-e5cfa79fede5"
    },
    {
      "binding": "A13_DB",
      "database_name": "test-listing-content-state",
      "database_id": "0422f453-e542-47dd-905e-51f5e451e427"
    },
    {
      "binding": "A14_DB",
      "database_name": "test-search-reporting-state",
      "database_id": "ab822b8f-9ad3-45ec-9143-4513aff0cf5b"
    },
    {
      "binding": "A15_DB",
      "database_name": "test-platform-ops-state",
      "database_id": "3d76527c-ae04-4c65-a8e1-e5cfa79fede5"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_EVENTS",
        "queue": "test-platform-events"
      }
    ],
    "consumers": [
      {
        "queue": "test-platform-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "test-platform-events-dlq"
      },
      {
        "queue": "test-platform-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 1
      }
    ]
  }
}
